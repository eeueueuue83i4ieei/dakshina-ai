# Copy this file to .env and paste a NEWLY ROTATED Gemini API key after revoking the exposed one.
# Never commit .env or paste the key into index.html.
GEMINI_API_KEY=PASTE_NEW_GEMINI_API_KEY_HERE
PORT=8080
# Set to 1 only when your hosting provider securely overwrites X-Forwarded-For.
TRUST_PROXY=0
